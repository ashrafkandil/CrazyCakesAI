# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Google Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional settings
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# ASSISTANT_RATE_LIMIT_PER_MINUTE=15

# Where the SQLite database lives. Optional: with nothing set it is
# data/crazy-cakes.db (gitignored). Point this at a persistent location - e.g. a
# mounted volume in production - so the data survives redeploys, then run
# "bun run db:seed" once to fill an empty database. After that the database is the
# source of truth: edit it with any SQLite tool, commit the edit, then refresh the
# page to see it; no rebuild or reseed is needed. "bun run db:seed" is a no-op once
# data exists; "bun run db:seed:force"
# resets it back to the seed. "bun run db:backup" writes a timestamped copy next to it.
# DB_PATH=/var/lib/crazy-cakes/crazy-cakes.db